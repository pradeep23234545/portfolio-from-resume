# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is ignored by git.

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Grants full database access — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Authentication ──────────────────────────────────────────
# Used to sign session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Google Gemini ───────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── GitHub OAuth ────────────────────────────────────────────
# https://github.com/settings/developers → New OAuth App
# Callback URL: <NEXT_PUBLIC_APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Optional: personal access token for higher GitHub API rate limits
GITHUB_ACCESS_TOKEN=

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
